{
  "name": "namespec",
  "displayName": "Namespec",
  "description": "Syntax highlighting, declaration hovers, go-to-definition and live example tests for Namespec naming rules (.names).",
  "version": "0.6.0",
  "main": "./extension.cjs",
  "publisher": "namespec-local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Testing"
  ],
  "activationEvents": [
    "workspaceContains:**/*.names"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Examples are only run in trusted workspaces, because running them starts the namespec command.",
      "restrictedConfigurations": [
        "namespec.command"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "contributes": {
    "languages": [
      {
        "id": "namespec",
        "aliases": [
          "Namespec",
          "namespec"
        ],
        "extensions": [
          ".names"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "namespec",
        "scopeName": "source.namespec",
        "path": "./syntaxes/namespec.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Namespec",
      "properties": {
        "namespec.command": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "The `namespec` executable that runs a rule file's examples. Leave empty to use the nearest `.venv` at or above the rule file, then `namespec` on `PATH`."
        }
      }
    }
  },
  "dependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
