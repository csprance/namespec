{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Namespec",
  "scopeName": "source.namespec",
  "patterns": [
    { "include": "#comments" },
    { "include": "#templates" },
    { "include": "#strings" },
    {
      "match": "\\b(resource|example|reject)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.namespec" },
        "2": { "name": "entity.name.type.namespec" }
      }
    },
    { "match": "\\b(?:text|integer)\\b", "name": "storage.type.namespec" },
    {
      "match": "\\b(?:spec|matching|examples|minimum|padded|to|digits|one|of|readers|roots|normalize|meta|expect)\\b",
      "name": "keyword.control.namespec"
    },
    {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*=)",
      "name": "variable.other.property.namespec"
    },
    { "match": "\\b[0-9]+\\b", "name": "constant.numeric.namespec" },
    { "match": "=", "name": "keyword.operator.assignment.namespec" },
    { "match": "[{}\\[\\]]", "name": "punctuation.section.braces.namespec" },
    { "match": ",", "name": "punctuation.separator.namespec" },
    { "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b", "name": "variable.other.namespec" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.namespec",
      "begin": "//",
      "end": "$"
    },
    "templates": {
      "patterns": [
        {
          "comment": "Resource name and location templates, wherever they appear on a line.",
          "name": "meta.assignment.template.namespec",
          "begin": "\\b(name|location)\\s*(=)\\s*([\"'])",
          "beginCaptures": {
            "1": { "name": "variable.other.property.namespec" },
            "2": { "name": "keyword.operator.assignment.namespec" },
            "3": { "name": "punctuation.definition.string.begin.namespec" }
          },
          "end": "\\3",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.namespec" } },
          "contentName": "string.quoted.template.namespec",
          "patterns": [{ "include": "#slots" }]
        },
        {
          "comment": "Composite field declarations such as Shot = \"{Sequence}_{shotnum}\" start a line. Keyword-led entries (input, expect) stay plain strings.",
          "name": "meta.assignment.template.namespec",
          "begin": "^\\s*(?!(?:spec|input|expect|resource|example|reject|readers|roots|meta)\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*([\"'])",
          "beginCaptures": {
            "1": { "name": "variable.other.property.namespec" },
            "2": { "name": "keyword.operator.assignment.namespec" },
            "3": { "name": "punctuation.definition.string.begin.namespec" }
          },
          "end": "\\3",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.namespec" } },
          "contentName": "string.quoted.template.namespec",
          "patterns": [{ "include": "#slots" }]
        }
      ]
    },
    "slots": {
      "patterns": [
        { "include": "#escapes" },
        { "match": "\\{\\{|\\}\\}", "name": "constant.character.escape.namespec" },
        { "match": "[\\[\\]]", "name": "punctuation.section.optional.namespec" },
        {
          "match": "(\\{)([A-Za-z_][A-Za-z0-9_]*)(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.interpolation.begin.namespec" },
            "2": { "name": "variable.parameter.namespec" },
            "3": { "name": "punctuation.definition.interpolation.end.namespec" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.namespec",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.single.namespec",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#escapes" }]
        }
      ]
    },
    "escapes": { "match": "\\\\.", "name": "constant.character.escape.namespec" }
  }
}
